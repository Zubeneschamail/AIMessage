# 钉钉机器人配置 (支持多个，用逗号分隔)
# 格式: webhook_url 或 webhook_url|secret
# 示例单个: https://oapi.dingtalk.com/robot/send?access_token=xxx
# 示例多个: https://oapi.dingtalk.com/robot/send?access_token=xxx|SEC123,https://oapi.dingtalk.com/robot/send?access_token=yyy
DINGTALK_WEBHOOKS=

# 推送时间配置 (24小时制，用逗号分隔)
# 示例: 8,12,18 表示每天 08:00, 12:00, 18:00 推送
PUSH_HOURS=8,12,18

# 翻译配置 (true/false)
# 开启后会将英文资讯翻译成中文再推送
ENABLE_TRANSLATION=true

# 数据保留天数
CLEANUP_DAYS_RETAIN=30
